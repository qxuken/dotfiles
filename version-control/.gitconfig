[init]
    defaultbranch = main

[merge]
    conflictstyle = zdiff3

[user]
    name = Nasonov Viktor
    email = me@qxuken.dev

# Last, so a machine can override anything above. Silently skipped when absent,
# so this line is safe on a machine that has no local config of its own.
[include]
    path = ~/.gitconfig.local
